NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — server (Browse, Server Actions)
SUPABASE_URL=https://hivszhjedfjpeenbewdf.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Supabase — browser (Realtime on the Watchlist and /status only)
NEXT_PUBLIC_SUPABASE_URL=https://hivszhjedfjpeenbewdf.supabase.co
